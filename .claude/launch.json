{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "deckmix-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "deckmix-listen",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/listen-downbeat.mjs"
      ],
      "port": 5188
    },
    {
      "name": "deckmix-listen-test",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/listen-downbeat.mjs",
        "--holdout"
      ],
      "port": 5189
    },
    {
      "name": "deckmix-listen-fresh",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/listen-downbeat.mjs",
        "--fresh"
      ],
      "port": 5190
    },
    {
      "name": "deckmix-listen-pickup",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/listen-downbeat.mjs",
        "--pickup"
      ],
      "port": 5191
    }
  ]
}
